// =====================================================================
//  Measures - only what the three report pages use.
//  Create a blank table "_Measures" (Enter data, one dummy column, then
//  hide the column) and add every measure to it so they sit together.
//  Format strings are given as a comment after each measure name; the
//  section headers are the display folders.
// =====================================================================


// ==================== Audit viewer ====================================

Audit Events =                                   // #,0
COUNTROWS ( AuditEvents )

Property Changes =                               // #,0
COUNTROWS ( AuditPropertyChanges )

Latest Event Loaded =                            // dd MMM yyyy HH:mm   (local time; tells you how fresh the data is)
MAX ( AuditEvents[EventDateTimeLocal] )


// ==================== Agent presence ==================================

Presence Changes =                               // #,0
COALESCE ( CALCULATE ( [Audit Events], AuditEvents[IsPresenceEvent] = TRUE () ), 0 )

Agents Affected =                                // #,0
COALESCE (
    CALCULATE ( DISTINCTCOUNTNOBLANK ( AuditEvents[EntityId] ), AuditEvents[IsPresenceEvent] = TRUE () ),
    0
)

Changed By Someone Else =                        // #,0   (a supervisor, admin or integration changed the agent's status)
COALESCE (
    CALCULATE (
        [Audit Events],
        AuditEvents[IsPresenceEvent] = TRUE (),
        AuditEvents[PresenceChangeSource] IN { "Another person", "Integration" }
    ),
    0
)


// ==================== API usage =======================================

API Requests =                                   // #,0
SUM ( ApiUsage[Requests] )

Requests in Period =                             // #,0   (0 instead of blank, so idle clients still list)
COALESCE ( [API Requests], 0 )

API Errors =                                     // #,0   (4xx + 5xx; the 429s are part of the 4xx)
SUM ( ApiUsage[Errors] )

API Error % =                                    // 0.0%
DIVIDE ( [API Errors], [API Requests] )

Rate Limited (429) =                             // #,0
SUM ( ApiUsage[Status429] )

Server Errors (5xx) =                            // #,0
SUM ( ApiUsage[Status5xx] )

Active Clients =                                 // #,0   (clients that made at least one request)
CALCULATE ( DISTINCTCOUNT ( ApiUsage[ClientKey] ), ApiUsage[Requests] > 0 )

Last API Use =                                   // dd MMM yyyy
MAX ( ApiUsage[Date] )

Changes Made by Client =                         // #,0   (audit events the OAuth client caused)
COALESCE ( CALCULATE ( [Audit Events], AuditEvents[ActorType] = "OAuth Client" ), 0 )
