// =====================================================================
//  Dimension tables built FROM the fact table (Modeling > New table).
//
//  Why DAX and not Power Query?  AuditEvents uses incremental refresh.
//  A Power Query dimension that references the fact would be evaluated
//  with the *published* RangeStart/RangeEnd values and silently miss
//  users/actions that only appear in newer partitions. A calculated
//  table is rebuilt from whatever is actually loaded, every refresh.
//
//  Relationships (all single direction, dimension 1 --> * fact):
//     DimUser[UserKey]          --> AuditEvents[UserKey]
//     DimClient[ClientKey]      --> AuditEvents[ClientKey]
//     DimService[ServiceName]   --> AuditEvents[ServiceName]
//     DimAction[Action]         --> AuditEvents[Action]
//     DimEntityType[EntityType] --> AuditEvents[EntityType]
//     AuditEvents[AuditId]      --> AuditPropertyChanges[AuditId]   (1:*, single)
// =====================================================================


// ---------------------------------------------------------------------
//  IMPORTANT - lineage. A column produced by SUMMARIZE / DISTINCT / VALUES
//  keeps "lineage" to the fact column (the engine calls it
//  AuditEvents[UserKey], not UserKey). A relationship to such a column is
//  rejected when a project file is loaded ("uses an invalid column ID").
//  Every dimension below therefore ends with SELECTCOLUMNS and `& ""` on
//  the key, which turns it into a plain, stand-alone column.
// ---------------------------------------------------------------------
DimUser =
// Your own org id = the userHomeOrgId that appears on most events. A user whose
// home org differs is a trustee (partner) user acting under an org trust.
VAR _homeOrg =
    MAXX (
        TOPN ( 1,
            ADDCOLUMNS ( VALUES ( AuditEvents[UserHomeOrgId] ), "@n", CALCULATE ( COUNTROWS ( AuditEvents ) ) ),
            [@n], DESC ),
        AuditEvents[UserHomeOrgId] )
VAR _t =
    ADDCOLUMNS (
        SUMMARIZE ( AuditEvents, AuditEvents[UserKey] ),
        "@UserId",         CALCULATE ( MAX ( AuditEvents[UserId] ) ),
        "@UserName",       CALCULATE ( MAX ( AuditEvents[UserName] ) ),
        "@UserHomeOrgId",  CALCULATE ( MAX ( AuditEvents[UserHomeOrgId] ) ),
        "@FirstSeen",      CALCULATE ( MIN ( AuditEvents[EventDateUtc] ) ),
        "@LastSeen",       CALCULATE ( MAX ( AuditEvents[EventDateUtc] ) ),
        "@LifetimeEvents", CALCULATE ( COUNTROWS ( AuditEvents ) )
    )
RETURN
    SELECTCOLUMNS (
        _t,
        "UserKey",         AuditEvents[UserKey] & "",
        "UserId",          [@UserId],
        "UserName",        [@UserName],
        "UserHomeOrgId",   [@UserHomeOrgId],
        "First Seen",      [@FirstSeen],
        "Last Seen",       [@LastSeen],
        "Lifetime Events", [@LifetimeEvents],
        "User",
            SWITCH ( TRUE (),
                AuditEvents[UserKey] = "SYSTEM", "System / no user",
                NOT ISBLANK ( [@UserName] ) && [@UserName] <> "", [@UserName],
                [@UserId] ),
        "IsExternalUser",
            AuditEvents[UserKey] <> "SYSTEM"
                && NOT ISBLANK ( [@UserHomeOrgId] )
                && [@UserHomeOrgId] <> _homeOrg
    )


// ---------------------------------------------------------------------
DimClient =
VAR _t =
    ADDCOLUMNS (
        SUMMARIZE ( AuditEvents, AuditEvents[ClientKey] ),
        "@ClientId",       CALCULATE ( MAX ( AuditEvents[ClientId] ) ),
        "@ClientName",     CALCULATE ( MAX ( AuditEvents[ClientName] ) ),
        "@FirstSeen",      CALCULATE ( MIN ( AuditEvents[EventDateUtc] ) ),
        "@LastSeen",       CALCULATE ( MAX ( AuditEvents[EventDateUtc] ) ),
        "@LifetimeEvents", CALCULATE ( COUNTROWS ( AuditEvents ) )
    )
RETURN
    SELECTCOLUMNS (
        _t,
        "ClientKey",       AuditEvents[ClientKey] & "",
        "ClientId",        [@ClientId],
        "ClientName",      [@ClientName],
        "First Seen",      [@FirstSeen],
        "Last Seen",       [@LastSeen],
        "Lifetime Events", [@LifetimeEvents],
        "Client",
            VAR _mapped = LOOKUPVALUE ( ClientMap[ClientName], ClientMap[ClientId], [@ClientId] )
            RETURN
                SWITCH ( TRUE (),
                    AuditEvents[ClientKey] = "NONE", "(no client)",
                    NOT ISBLANK ( _mapped ), _mapped,
                    NOT ISBLANK ( [@ClientName] ) && [@ClientName] <> "", [@ClientName],
                    [@ClientId] )
    )


// ---------------------------------------------------------------------
DimService =
ADDCOLUMNS (
    DISTINCT ( SELECTCOLUMNS ( AuditEvents, "ServiceName", AuditEvents[ServiceName] & "" ) ),
    "Service",
        COALESCE ( LOOKUPVALUE ( ServiceMap[Service], ServiceMap[ServiceName], [ServiceName] ), [ServiceName] ),
    "ServiceCategory",
        COALESCE ( LOOKUPVALUE ( ServiceMap[ServiceCategory], ServiceMap[ServiceName], [ServiceName] ), "Other" )
)


// ---------------------------------------------------------------------
DimAction =
ADDCOLUMNS (
    DISTINCT ( SELECTCOLUMNS ( AuditEvents, "Action", AuditEvents[Action] & "" ) ),
    "RiskLevel",
        COALESCE ( LOOKUPVALUE ( ActionRiskMap[RiskLevel], ActionRiskMap[Action], [Action] ), "Medium" ),
    "ActionCategory",
        COALESCE ( LOOKUPVALUE ( ActionRiskMap[ActionCategory], ActionRiskMap[Action], [Action] ), "Other" ),
    "RiskSort",
        COALESCE ( LOOKUPVALUE ( ActionRiskMap[RiskSort], ActionRiskMap[Action], [Action] ), 2 )
)
// Sort-by: RiskLevel -> RiskSort


// ---------------------------------------------------------------------
DimEntityType =
VAR _t =
    ADDCOLUMNS (
        SUMMARIZE ( AuditEvents, AuditEvents[EntityType] ),
        "@LifetimeEvents", CALCULATE ( COUNTROWS ( AuditEvents ) ),
        "@Services",
            CONCATENATEX ( CALCULATETABLE ( VALUES ( AuditEvents[ServiceName] ) ), AuditEvents[ServiceName], ", " )
    )
RETURN
    SELECTCOLUMNS (
        _t,
        "EntityType",      AuditEvents[EntityType] & "",
        "Lifetime Events", [@LifetimeEvents],
        "Services",        [@Services]
    )


// ---------------------------------------------------------------------
//  "Group By" field parameter  (Modeling > New parameter > Fields)
//  Create it through the UI and add these fields in this order; the DAX
//  below is what the UI generates and is here only for reference.
// ---------------------------------------------------------------------
