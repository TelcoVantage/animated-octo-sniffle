//     ( "Service",     NAMEOF ( 'DimService'[Service] ),        0 ),
//     ( "Category",    NAMEOF ( 'DimService'[ServiceCategory] ),1 ),
//     ( "Action",      NAMEOF ( 'DimAction'[Action] ),          2 ),
//     ( "Risk level",  NAMEOF ( 'DimAction'[RiskLevel] ),       3 ),
//     ( "Entity type", NAMEOF ( 'DimEntityType'[EntityType] ),  4 ),
//     ( "User",        NAMEOF ( 'DimUser'[User] ),              5 ),
//     ( "Client",      NAMEOF ( 'DimClient'[Client] ),          6 ),
//     ( "Actor type",  NAMEOF ( 'AuditEvents'[ActorType] ),     7 ),
//     ( "Status",      NAMEOF ( 'AuditEvents'[Status] ),        8 )
// }
