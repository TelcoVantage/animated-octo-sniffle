	column 'Lifetime Requests'
		dataType: int64
		formatString: #,0
		lineageTag: e731cc67-347a-5746-b5a7-c7bef2772892
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lifetime Requests]

		annotation SummarizationSetBy = Automatic

	partition DimClient = calculated
		mode: import
		source =
				VAR _keys =
				    DISTINCT (
				        UNION (
				            SELECTCOLUMNS ( AuditEvents, "ClientKey", AuditEvents[ClientKey] & "" ),
				            SELECTCOLUMNS ( ApiUsage, "ClientKey", ApiUsage[ClientKey] & "" ),
				            SELECTCOLUMNS ( OAuthClients, "ClientKey", OAuthClients[ClientId] & "" )
				        )
				    )
				VAR _t =
				    ADDCOLUMNS (
				        _keys,
				        "@Name",
				            VAR k = [ClientKey]
				            RETURN
				                COALESCE (
				                    LOOKUPVALUE ( OAuthClients[ClientName], OAuthClients[ClientId], k ),
				                    CALCULATE ( MAX ( ApiUsage[ClientName] ), ApiUsage[ClientKey] = k ),
				                    CALCULATE ( MAX ( AuditEvents[ClientName] ), AuditEvents[ClientKey] = k )
				                ),
				        "@GrantType",     VAR k = [ClientKey] RETURN LOOKUPVALUE ( OAuthClients[GrantType], OAuthClients[ClientId], k ),
				        "@State",         VAR k = [ClientKey] RETURN LOOKUPVALUE ( OAuthClients[State], OAuthClients[ClientId], k ),
				        "@Created",       VAR k = [ClientKey] RETURN LOOKUPVALUE ( OAuthClients[DateCreated], OAuthClients[ClientId], k ),
				        "@AuditFirst",    VAR k = [ClientKey] RETURN CALCULATE ( MIN ( AuditEvents[EventDateLocal] ), AuditEvents[ClientKey] = k ),
				        "@AuditLast",     VAR k = [ClientKey] RETURN CALCULATE ( MAX ( AuditEvents[EventDateLocal] ), AuditEvents[ClientKey] = k ),
				        "@UsageFirst",    VAR k = [ClientKey] RETURN CALCULATE ( MIN ( ApiUsage[Date] ), ApiUsage[ClientKey] = k ),
				        "@UsageLast",     VAR k = [ClientKey] RETURN CALCULATE ( MAX ( ApiUsage[Date] ), ApiUsage[ClientKey] = k ),
				        "@Events",        VAR k = [ClientKey] RETURN CALCULATE ( COUNTROWS ( AuditEvents ), AuditEvents[ClientKey] = k ),
				        "@Requests",      VAR k = [ClientKey] RETURN CALCULATE ( SUM ( ApiUsage[Requests] ), ApiUsage[ClientKey] = k )
				    )
				RETURN
				    SELECTCOLUMNS (
				        _t,
				        "ClientKey",         [ClientKey] & "",
				        "ClientId",          IF ( [ClientKey] = "NONE", BLANK (), [ClientKey] ),
				        "ClientName",        [@Name],
				        "Client",
				            SWITCH ( TRUE (),
				                [ClientKey] = "NONE", "(no client)",
				                NOT ISBLANK ( [@Name] ) && [@Name] <> "", [@Name],
				                [ClientKey] ),
				        "Grant Type",        [@GrantType],
				        "State",             [@State],
				        "Created",           [@Created],
				        "First Seen",        MINX ( { [@AuditFirst], [@UsageFirst] }, [Value] ),
				        "Last Seen",         MAXX ( { [@AuditLast], [@UsageLast] }, [Value] ),
				        "Lifetime Events",   [@Events],
				        "Lifetime Requests", [@Requests]
				    )

	annotation PBI_ResultType = Table
