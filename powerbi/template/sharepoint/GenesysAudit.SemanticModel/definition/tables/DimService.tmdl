table DimService
	lineageTag: 22337fea-cdaf-5ffb-80e1-2db55fbfdd0d

	column ServiceName
		dataType: string
		lineageTag: eb763e68-0cce-5a27-a40d-5830ca94fa08
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [ServiceName]

		annotation SummarizationSetBy = Automatic

	column Service
		dataType: string
		lineageTag: b81d9d5a-fc8d-5bee-a575-47a850a21328
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Service]

		annotation SummarizationSetBy = Automatic

	column ServiceCategory
		dataType: string
		lineageTag: f8445300-d8e8-5b5f-9868-ff391a83803b
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [ServiceCategory]

		annotation SummarizationSetBy = Automatic

	partition DimService = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    DISTINCT ( SELECTCOLUMNS ( AuditEvents, "ServiceName", AuditEvents[ServiceName] & "" ) ),
				    "Service",
				        COALESCE ( LOOKUPVALUE ( ServiceMap[Service], ServiceMap[ServiceName], [ServiceName] ), [ServiceName] ),
				    "ServiceCategory",
				        COALESCE ( LOOKUPVALUE ( ServiceMap[ServiceCategory], ServiceMap[ServiceName], [ServiceName] ), "Other" )
				)

	annotation PBI_ResultType = Table
