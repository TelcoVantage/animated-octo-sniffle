	partition RelatedEvents = calculated
		mode: import
		source =
				SELECTCOLUMNS (
				    AuditEvents,
				    "AuditId",            AuditEvents[AuditId] & "",
				    "TransactionKey",     AuditEvents[TransactionKey] & "",
				    "EventDateTimeLocal", AuditEvents[EventDateTimeLocal] + 0,
				    "ActorName",          AuditEvents[ActorName] & "",
				    "ServiceName",        AuditEvents[ServiceName] & "",
				    "Action",             AuditEvents[Action] & "",
				    "EntityType",         AuditEvents[EntityType] & "",
				    "EntityDisplay",      AuditEvents[EntityDisplay] & "",
				    "Status",             AuditEvents[Status] & "",
				    "Application",        AuditEvents[Application] & "",
				    "Message",            AuditEvents[Message] & "",
				    "TransactionInitiator", AuditEvents[TransactionInitiator] = TRUE ()
				)

	annotation PBI_ResultType = Table
