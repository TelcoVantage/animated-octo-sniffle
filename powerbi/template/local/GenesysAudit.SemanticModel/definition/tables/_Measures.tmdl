table _Measures
	lineageTag: 1d554758-3073-5bf0-ab29-d96f16b1a0f2

	column Value
		dataType: string
		isHidden
		lineageTag: 1fb8c88f-d87a-5a9f-823b-8a72688e1817
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	measure 'Audit Events' = COUNTROWS ( AuditEvents )
		formatString: #,0
		displayFolder: Audit viewer
		lineageTag: 60b68426-0e70-5cd9-8d77-b25864ae2634

	measure 'Property Changes' = COUNTROWS ( AuditPropertyChanges )
		formatString: #,0
		displayFolder: Audit viewer
		lineageTag: 1ee84a8d-69b9-51e5-80c5-d7a152fa7aa2

	measure 'Latest Event Loaded' = MAX ( AuditEvents[EventDateTimeLocal] )
		formatString: dd MMM yyyy HH:mm
		displayFolder: Audit viewer
		lineageTag: 3417c877-5168-5812-b8d2-ac1cdbe79ce3

	measure 'Presence Changes' = COALESCE ( CALCULATE ( [Audit Events], AuditEvents[IsPresenceEvent] = TRUE () ), 0 )
		formatString: #,0
		displayFolder: Agent presence
		lineageTag: d27bcf09-de94-507d-b997-8b53f77869b5

	measure 'Agents Affected' =
			COALESCE (
			    CALCULATE ( DISTINCTCOUNTNOBLANK ( AuditEvents[EntityId] ), AuditEvents[IsPresenceEvent] = TRUE () ),
			    0
			)
		formatString: #,0
		displayFolder: Agent presence
		lineageTag: 31009b38-0d6a-50ed-af3d-483fae380515

	measure 'Changed By Someone Else' =
			COALESCE (
			    CALCULATE (
			        [Audit Events],
			        AuditEvents[IsPresenceEvent] = TRUE (),
			        AuditEvents[PresenceChangeSource] IN { "Another person", "Integration" }
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Agent presence
		lineageTag: a93a6d80-0b22-5815-8556-822528a22bf1

	measure 'API Requests' = SUM ( ApiUsage[Requests] )
		formatString: #,0
		displayFolder: API usage
		lineageTag: 837b19a4-9443-560d-9805-dee71b8fcaaf

	measure 'Requests in Period' = COALESCE ( [API Requests], 0 )
		formatString: #,0
		displayFolder: API usage
		lineageTag: 9e9e7fae-b119-5b60-a733-e11c6f08b49f

	measure 'API Errors' = SUM ( ApiUsage[Errors] )
		formatString: #,0
		displayFolder: API usage
		lineageTag: da7ef314-9e53-52d0-b9f1-0be890d65183

	measure 'API Error %' = DIVIDE ( [API Errors], [API Requests] )
		formatString: 0.0%
		displayFolder: API usage
		lineageTag: 3d19bdd3-564c-5452-b7a3-3fd87656122f

	measure 'Rate Limited (429)' = SUM ( ApiUsage[Status429] )
		formatString: #,0
		displayFolder: API usage
		lineageTag: 2983e23c-62bd-5859-bddf-d87bb1edb6b1

	measure 'Server Errors (5xx)' = SUM ( ApiUsage[Status5xx] )
		formatString: #,0
		displayFolder: API usage
		lineageTag: 4f54096c-7020-5b26-adc5-e1a5dcc3ec1d

	measure 'Active Clients' = CALCULATE ( DISTINCTCOUNT ( ApiUsage[ClientKey] ), ApiUsage[Requests] > 0 )
		formatString: #,0
		displayFolder: API usage
		lineageTag: 03ccace4-8321-53d2-8e82-69af93adf1cc

	measure 'Last API Use' = MAX ( ApiUsage[Date] )
		formatString: dd MMM yyyy
		displayFolder: API usage
		lineageTag: 77e495de-f2d9-55e3-94c7-5ef3c710b57c

	measure 'Changes Made by Client' = COALESCE ( CALCULATE ( [Audit Events], AuditEvents[ActorType] = "OAuth Client" ), 0 )
		formatString: #,0
		displayFolder: API usage
		lineageTag: 1087fb8a-5813-5dbe-8f46-ddfcfa020245

	partition _Measures = calculated
		mode: import
		source =
				{ "measures" }

	annotation PBI_ResultType = Table
