	column IsExternalUser
		dataType: boolean
		lineageTag: dbdeb6bc-32ba-51ad-8637-9e05828a8020
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [IsExternalUser]

		annotation SummarizationSetBy = Automatic

	partition DimUser = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    SUMMARIZE ( AuditEvents, AuditEvents[UserKey] ),
				    "UserId",          CALCULATE ( MAX ( AuditEvents[UserId] ) ),
				    "UserName",        CALCULATE ( MAX ( AuditEvents[UserName] ) ),
				    "UserHomeOrgId",   CALCULATE ( MAX ( AuditEvents[UserHomeOrgId] ) ),
				    "UserTrusteeOrgId",CALCULATE ( MAX ( AuditEvents[UserTrusteeOrgId] ) ),
				    "First Seen",      CALCULATE ( MIN ( AuditEvents[EventDateUtc] ) ),
				    "Last Seen",       CALCULATE ( MAX ( AuditEvents[EventDateUtc] ) ),
				    "Lifetime Events", CALCULATE ( COUNTROWS ( AuditEvents ) ),
				    "User",
				        VAR _name = CALCULATE ( MAX ( AuditEvents[UserName] ) )
				        VAR _id   = CALCULATE ( MAX ( AuditEvents[UserId] ) )
				        RETURN
				            SWITCH ( TRUE (),
				                AuditEvents[UserKey] = "SYSTEM", "System / no user",
				                NOT ISBLANK ( _name ) && _name <> "", _name,
				                _id ),
				    // A trustee (partner) user acting on your org under an org trust has a
				    // home org that differs from the trustee org on the event.
				    "IsExternalUser",
				        VAR _home    = CALCULATE ( MAX ( AuditEvents[UserHomeOrgId] ) )
				        VAR _trustee = CALCULATE ( MAX ( AuditEvents[UserTrusteeOrgId] ) )
				        RETURN NOT ISBLANK ( _home ) && NOT ISBLANK ( _trustee ) && _home <> _trustee
				)

	annotation PBI_ResultType = Table
