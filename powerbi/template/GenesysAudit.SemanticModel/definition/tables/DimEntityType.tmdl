	partition DimEntityType = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    DISTINCT ( SELECTCOLUMNS ( AuditEvents, "EntityType", AuditEvents[EntityType] ) ),
				    "Lifetime Events", CALCULATE ( COUNTROWS ( AuditEvents ) ),
				    "Services",
				        CONCATENATEX ( CALCULATETABLE ( VALUES ( AuditEvents[ServiceName] ) ), AuditEvents[ServiceName], ", " )
				)

	annotation PBI_ResultType = Table
