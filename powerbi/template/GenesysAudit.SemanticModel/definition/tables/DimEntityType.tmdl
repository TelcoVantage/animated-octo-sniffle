table DimEntityType
	lineageTag: 4dd91a58-5832-558f-9b99-aeccdfc1f4ee

	column EntityType
		dataType: string
		lineageTag: 9e5dad94-d075-548c-be43-bd084cde1ba4
		summarizeBy: none
		isNameInferred
